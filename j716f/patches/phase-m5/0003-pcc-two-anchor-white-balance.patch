+/*
+ * Backlight level for the white-point trim.  The class backlight of the
+ * panel registers some time after the display pipeline comes up, so the
+ * device pointer is resolved from a work queue; afterwards the level is
+ * read directly from the cached properties (a plain int read, safe in the
+ * commit path).  Until it is found, or if there is none, behave as if the
+ * panel sits at full brightness.
+ */
+static struct backlight_device *pcc_bl;
+static unsigned int pcc_bl_tries;
+
+static void dpu_pcc_find_backlight(struct work_struct *work)
+{
+	pcc_bl = backlight_device_get_by_type(BACKLIGHT_RAW);
+	if (!pcc_bl && ++pcc_bl_tries < 4)
+		schedule_delayed_work(to_delayed_work(work), 10 * HZ);
+}
+static DECLARE_DELAYED_WORK(dpu_pcc_bl_work, dpu_pcc_find_backlight);
+
+/* Backlight level scaled to 0..1024, 1024 = full brightness. */
+static unsigned int dpu_pcc_brightness_frac(void)
+{
+	unsigned int level, max;
+
+	if (!pcc_bl)
+		return 1024;
+
+	level = READ_ONCE(pcc_bl->props.brightness);
+	max = READ_ONCE(pcc_bl->props.max_brightness);
+	if (!max)
+		return 1024;
+	if (level > max)
+		level = max;
+
+	return level * 1024 / max;
+}
+
+/* Interpolate between the min- and max-backlight gains. */
+static u32 dpu_pcc_gain_interp(unsigned int hi, unsigned int lo,
+			       unsigned int frac)
+{
+	int q10 = (int)lo + (((int)hi - (int)lo) * (int)frac >> 10);
+
+	if (q10 < 0)
+		q10 = 0;
+
+	return dpu_pcc_gain_s3_15(q10);
+}
