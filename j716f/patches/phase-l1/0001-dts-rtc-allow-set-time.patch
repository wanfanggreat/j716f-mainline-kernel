--- a/arch/arm64/boot/dts/qcom/sm8250-lenovo-j716f.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-lenovo-j716f.dts
@@ -978,3 +978,14 @@
 
 	vdds-supply = <&vreg_l5a_0p88>;
 };
+
+/*
+ * Phase L1: 让 PM8150 RTC 可由用户态写入。
+ * 主线 rtc-pm8xxx 只在 DT 有 allow-set-time 时调用 set_time；没有它时
+ * hwclock -w 返回 ENODEV，系统时间在重启后回到 1970。
+ */
+&pm8150_0 {
+	rtc@6000 {
+		allow-set-time;
+	};
+};
