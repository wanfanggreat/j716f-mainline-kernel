+/*
+ * Lenovo J716F: send ASM_CMD_SHARED_MEM_MAP_REGIONS with every plausible
+ * encoding of the 64-bit shared-memory address until the ADSP accepts one.
+ * See the map_mode comment near the top of the file.
+ */
+static int q6asm_dai_map_regions(struct device *dev,
+				 struct snd_pcm_substream *substream,
+				 struct q6asm_dai_rtd *prtd, u64 sid_bits)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	dma_addr_t dma_addr = substream->dma_buffer.addr;
+	phys_addr_t phys_addr = 0;
+	size_t period_sz;
+	int order[4], n = 0, i, mode, ret;
+
+	if (!prtd->periods) {
+		dev_err(dev, "J716F-ASM: no periods for the DMA map\n");
+		return -EINVAL;
+	}
+	period_sz = prtd->pcm_size / prtd->periods;
+
+	if (runtime->dma_area && !is_vmalloc_addr(runtime->dma_area))
+		phys_addr = virt_to_phys(runtime->dma_area);
+
+	if (map_mode >= 0) {
+		order[n++] = map_mode;
+	} else {
+		if (map_mode_ok >= 0)
+			order[n++] = map_mode_ok;
+		for (i = 0; i < 4; i++)
+			if (i != map_mode_ok)
+				order[n++] = i;
+	}
+
+	for (i = 0; i < n; i++) {
+		phys_addr_t phys;
+
+		mode = order[i];
+		switch (mode) {
+		case 0:
+			phys = dma_addr | sid_bits;
+			break;
+		case 1:
+			phys = (phys_addr_t)lower_32_bits(dma_addr);
+			break;
+		case 2:
+			if (!phys_addr)
+				continue;
+			phys = phys_addr | sid_bits;
+			break;
+		case 3:
+		default:
+			if (!phys_addr)
+				continue;
+			phys = phys_addr;
+			break;
+		}
+
+		ret = q6asm_map_memory_regions(substream->stream,
+					       prtd->audio_client, phys,
+					       period_sz, prtd->periods);
+		dev_err(dev,
+			"J716F-ASM: map dir=%d mode=%d phys=%#llx dma=%#llx pa=%#llx sid=%#llx period=%zu periods=%u -> %d\n",
+			substream->stream, mode, (unsigned long long)phys,
+			(unsigned long long)dma_addr,
+			(unsigned long long)phys_addr,
+			(unsigned long long)sid_bits, period_sz,
+			prtd->periods, ret);
+		if (!ret) {
+			prtd->phys = phys;
+			prtd->mapped = true;
+			map_mode_ok = mode;
+			return 0;
+		}
+	}
+
+	return -ENOMEM;
+}
