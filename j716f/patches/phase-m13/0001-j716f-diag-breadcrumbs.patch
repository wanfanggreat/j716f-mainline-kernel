+			drv->name, drv->irq, irqd ? irqd->hwirq : 0,
+			drv->num_tcs, in_use);
+
+		pret = irq_get_irqchip_state(drv->irq, IRQCHIP_STATE_PENDING,
+					     &gic_pend);
+		aret = irq_get_irqchip_state(drv->irq, IRQCHIP_STATE_ACTIVE,
