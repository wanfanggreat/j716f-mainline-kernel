+/*
+ * Lenovo J716F: the EDO/RM69380 panel has a slightly warm native white
+ * point, and the vendor display stack corrects it with a PCC matrix that
+ * the Android HAL programs (there is no mainline equivalent).  Every
+ * mainline kernel on this tablet therefore shows the same mild yellow
+ * cast, including the 6.15.11 reference tree.
+ *
+ * Keep a default diagonal PCC gain that userspace can use to neutralise
+ * it.  The values are Q10 (1024 = 1.0) and are only applied when
+ * userspace has not set a CTM itself, so a real colour management stack
+ * still wins.  The block is re-programmed on every atomic commit, which
+ * makes the parameters live: write them and look at the screen.
+ *
+ *   echo 1100 > /sys/module/msm/parameters/pcc_white_b
+ *   echo 1000 > /sys/module/msm/parameters/pcc_white_r
+ *
+ * The proper long-term fix is to recover the vendor calibration and bake
+ * it in, or to ship an ICC profile; this is the bring-up knob.
+ *
+ * The panel's white point also drifts warm as its brightness goes down, so
+ * one gain only holds at one level (v38b: neutral at max, yellow again at
+ * low).  pcc_white_* is the gain at full backlight and pcc_white_min_* is
+ * the gain at the bottom of the range; the active gain interpolates linearly
+ * with the class backlight level.  Tune pcc_white_* at max brightness and
+ * pcc_white_min_* at minimum brightness.
+ *
+ * Defaults are the values the user dialed in on 2026-11-07 with the RGB
+ * tuner: hi 949/973/1172 was accepted straight away, lo 970/772/1328 came
+ * from dragging the sliders because every preset guess was still too green
+ * (the panel loses far more green than assumed at low brightness).  Kept in
+ * the source so a fresh rootfs boots already calibrated.
+ */
+static unsigned int pcc_white_r = 949;
+static unsigned int pcc_white_g = 973;
+static unsigned int pcc_white_b = 1172;
+static unsigned int pcc_white_min_r = 970;
+static unsigned int pcc_white_min_g = 772;
+static unsigned int pcc_white_min_b = 1328;
+module_param(pcc_white_r, uint, 0644);
+MODULE_PARM_DESC(pcc_white_r, "J716F: PCC red gain at max backlight, Q10 (1024 = 1.0)");
+module_param(pcc_white_g, uint, 0644);
+MODULE_PARM_DESC(pcc_white_g, "J716F: PCC green gain at max backlight, Q10 (1024 = 1.0)");
+module_param(pcc_white_b, uint, 0644);
+MODULE_PARM_DESC(pcc_white_b, "J716F: PCC blue gain at max backlight, Q10 (1024 = 1.0)");
+module_param(pcc_white_min_r, uint, 0644);
+MODULE_PARM_DESC(pcc_white_min_r, "J716F: PCC red gain at min backlight, Q10");
+module_param(pcc_white_min_g, uint, 0644);
+MODULE_PARM_DESC(pcc_white_min_g, "J716F: PCC green gain at min backlight, Q10");
+module_param(pcc_white_min_b, uint, 0644);
+MODULE_PARM_DESC(pcc_white_min_b, "J716F: PCC blue gain at min backlight, Q10");
+
+static inline bool dpu_default_pcc_active(void)
+{
+	return pcc_white_r != 1024 || pcc_white_g != 1024 || pcc_white_b != 1024 ||
+	       pcc_white_min_r != 1024 || pcc_white_min_g != 1024 ||
+	       pcc_white_min_b != 1024;
+}
+
+/*
+ * Q10 -> the S3.15 the PCC register wants.  1.0 is 0x8000 and the positive
+ * range stops at 0x1ffff (3.9999), so 4096 must clamp to 4095: 4096 << 5 is
+ * 0x20000, which the block reads as -4.0 and would blank the screen.
+ */
+static inline u32 dpu_pcc_gain_s3_15(unsigned int q10)
+{
+	if (q10 > 4095)
+		q10 = 4095;
+
+	return q10 << 5;
+}
+
+/*
+ * Backlight level for the white-point trim.  The class backlight of the
+ * panel registers some time after the display pipeline comes up, so the
+ * device pointer is resolved from a work queue; afterwards the level is
+ * read directly from the cached properties (a plain int read, safe in the
+ * commit path).  Until it is found, or if there is none, behave as if the
+ * panel sits at full brightness.
+ */
+static struct backlight_device *pcc_bl;
+static unsigned int pcc_bl_tries;
+
+static void dpu_pcc_find_backlight(struct work_struct *work)
+{
+	pcc_bl = backlight_device_get_by_type(BACKLIGHT_RAW);
+	if (!pcc_bl && ++pcc_bl_tries < 4)
+		schedule_delayed_work(to_delayed_work(work), 10 * HZ);
+}
+static DECLARE_DELAYED_WORK(dpu_pcc_bl_work, dpu_pcc_find_backlight);
+
+/* Backlight level scaled to 0..1024, 1024 = full brightness. */
+static unsigned int dpu_pcc_brightness_frac(void)
+{
+	unsigned int level, max;
+
+	if (!pcc_bl)
+		return 1024;
+
+	level = READ_ONCE(pcc_bl->props.brightness);
+	max = READ_ONCE(pcc_bl->props.max_brightness);
+	if (!max)
+		return 1024;
+	if (level > max)
+		level = max;
+
+	return level * 1024 / max;
+}
+
+/* Interpolate between the min- and max-backlight gains. */
+static u32 dpu_pcc_gain_interp(unsigned int hi, unsigned int lo,
+			       unsigned int frac)
+{
+	int q10 = (int)lo + (((int)hi - (int)lo) * (int)frac >> 10);
+
+	if (q10 < 0)
+		q10 = 0;
+
+	return dpu_pcc_gain_s3_15(q10);
+}
