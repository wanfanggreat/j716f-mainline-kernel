--- a/arch/arm64/boot/dts/qcom/sm8250-lenovo-j716f.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-lenovo-j716f.dts
@@ -86,6 +86,23 @@
 		vin-supply = <&vph_pwr>;
 	};
 
+	/*
+	 * EDO EB50QBC73.A panel AVDD rail.  The 5.5 V value is the nominal
+	 * rail generated by the board's boost; the GPIO is the real control.
+	 */
+	panel_avdd: regulator-panel-avdd {
+		compatible = "regulator-fixed";
+
+		regulator-name = "display_panel_avdd";
+		regulator-min-microvolt = <5500000>;
+		regulator-max-microvolt = <5500000>;
+		regulator-enable-ramp-delay = <233>;
+		regulator-boot-on;
+
+		enable-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&vph_pwr>;
+	};
+
 	qca6390-pmu {
 		compatible = "qcom,qca6390-pmu";
 
@@ -675,6 +692,20 @@
 		bias-disable;
 	};
 
+	panel_te_active: panel-te-active-state {
+		pins = "gpio66";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	panel_te_suspend: panel-te-suspend-state {
+		pins = "gpio66";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
 	wlan_en: wlan-en-state {
 		pins = "gpio20";
 		function = "gpio";
@@ -746,3 +777,89 @@
 	firmware-name = "qcom/sm8250/LENOVO/J716F/venus.mbn";
 	status = "okay";
 };
+
+/*
+ * Display: EDO EB50QBC73.A AMOLED (Raydium RM69380), dual-DSI cmd mode.
+ *
+ * The board keeps the panel powered by the bootloader and exposes a
+ * simple-framebuffer; enabling mdss/DSI gives MDSS_GDSC a real consumer so
+ * the genpd sync_state path cannot power it off behind the driver's back.
+ */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	status = "okay";
+
+	vdda-supply = <&vreg_l9a_1p2>;
+
+	qcom,dual-dsi-mode;
+	qcom,sync-dual-dsi;
+	qcom,master-dsi;
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&panel_te_active>;
+	pinctrl-1 = <&panel_te_suspend>;
+
+	panel@0 {
+		compatible = "lenovo,j716f-edo-rm69380", "raydium,rm69380";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l14a_1p88>;
+		avdd-supply = <&panel_avdd>;
+		reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				panel_in_0: endpoint {
+					remote-endpoint = <&mdss_dsi0_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				panel_in_1: endpoint {
+					remote-endpoint = <&mdss_dsi1_out>;
+				};
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in_0>;
+};
+
+&mdss_dsi0_phy {
+	status = "okay";
+
+	vdds-supply = <&vreg_l5a_0p88>;
+};
+
+&mdss_dsi1 {
+	status = "okay";
+
+	vdda-supply = <&vreg_l9a_1p2>;
+
+	qcom,dual-dsi-mode;
+	qcom,sync-dual-dsi;
+};
+
+&mdss_dsi1_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in_1>;
+};
+
+&mdss_dsi1_phy {
+	status = "okay";
+
+	vdds-supply = <&vreg_l5a_0p88>;
+};
