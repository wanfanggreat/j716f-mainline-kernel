--- a/sound/soc/qcom/qdsp6/q6asm.c
+++ b/sound/soc/qcom/qdsp6/q6asm.c
@@ -363,13 +363,14 @@
 	pkt->hdr.dest_port = 0;
 	pkt->hdr.pkt_size = pkt_size;
 	/*
-	 * Lenovo J716F: the kona ADSP takes the direction in the flag byte of
-	 * the token (bit 0 of byte 3), exactly like the vendor kernel's
-	 * q6asm_update_token(), not in the stream-id byte. Playback (dir 0) is
-	 * identical either way; capture was being sent as stream 1 and the
-	 * ADSP rejected the following OPEN_READ with ADSP_EALREADY.
+	 * Keep the direction in the low nibble: q6asm_stream_callback()
+	 * recovers it with "hdr->token & 0x0F" to store the memory-map handle
+	 * in the right port.  Sending it in the flag byte (the vendor
+	 * kernel's layout) made every capture response land on the playback
+	 * port, so capture reads used a zero mem_map_handle and returned
+	 * silence.
 	 */
-	pkt->hdr.token = ((ac->session << 8) | (dir << 24));
+	pkt->hdr.token = ((ac->session << 8) | dir);
 
 	pkt->hdr.opcode = ASM_CMD_SHARED_MEM_UNMAP_REGIONS;
 	mem_unmap->mem_map_handle = ac->port[dir].mem_map_handle;
@@ -473,8 +474,8 @@
 	pkt->hdr.src_port = 0;
 	pkt->hdr.dest_port = 0;
 	pkt->hdr.pkt_size = pkt_size;
-	/* Direction goes in the token flag byte, see __q6asm_memory_unmap(). */
-	pkt->hdr.token = ((ac->session << 8) | (dir << 24));
+	/* Direction in the low nibble, see __q6asm_memory_unmap(). */
+	pkt->hdr.token = ((ac->session << 8) | dir);
 	pkt->hdr.opcode = ASM_CMD_SHARED_MEM_MAP_REGIONS;
 
 	cmd->mem_pool_id = ADSP_MEMORY_MAP_SHMEM8_4K_POOL;
