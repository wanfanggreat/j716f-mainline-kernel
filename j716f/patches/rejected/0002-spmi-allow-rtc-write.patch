  * v5 offset per ee and per apid for observer channels and per apid for
  * read/write channels.
  */
+static bool pmic_arb_is_rtc_ppid(u8 sid, u16 addr)
+{
+	/* PM8150 RTC: PPID 0x60 (time) and 0x61 (alarm). */
+	return sid == 0 && ((addr >> 8) == 0x60 || (addr >> 8) == 0x61);
+}
