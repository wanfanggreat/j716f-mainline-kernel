+/*
+ * The GT7385P touch controller is a GT9xx-protocol part (16-bit register
+ * addresses), not a Berlin part.  The vendor uses 100 kHz on this long,
+ * thin FPC and the GENI controller takes the GPI-DMA path otherwise; force
+ * the FIFO/PIO path for this bus.
+ */
+&qup_i2c13_default {
+	bias-pull-up;
+};
+
 &i2c13 {
-	clock-frequency = <400000>;
+	clock-frequency = <100000>;
 	status = "okay";
+	qcom,force-fifo;
+
+	touchscreen@5d {
+		compatible = "goodix,gt738x";
+		reg = <0x5d>;
+		goodix,debug-reports;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <39 IRQ_TYPE_EDGE_FALLING>;
 
-	/* GT7385P touchscreen @ 5d */
+		/*
+		 * Both GPIOs are ACTIVE_HIGH: goodix_reset_no_int_sync()
+		 * drives INT as an output to select the 0x5d I2C address
+		 * before releasing reset.  An ACTIVE_LOW irq-gpios would
+		 * select 0x14 instead and every read at 0x5d would time out.
+		 */
+		irq-gpios = <&tlmm 39 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&tlmm 38 GPIO_ACTIVE_HIGH>;
+
+		/*
+		 * goodix.c prefixes this with "goodix/", so the blob is at
+		 * /lib/firmware/goodix/j716f_cfg.bin.  Without the panel
+		 * configuration the controller never enters normal reporting
+		 * mode.
+		 */
+		goodix,config-name = "j716f_cfg.bin";
+
+		/*
+		 * Vendor rail map:
+		 *   pm8150a_l1  (1.8 V) -> vdd-supply / avdd-supply
+		 *   pm8150_l13  (3.0 V) -> AVDD28-supply
+		 *   pm8150_l14  (1.8 V) -> VDDIO-supply / vddio-supply
+		 */
+		avdd-supply = <&vreg_l1d_1p8>;
+		vdd-supply = <&vreg_l1d_1p8>;
+		vddio-supply = <&vreg_l14a_1p88>;
+		AVDD28-supply = <&vreg_l13a_3p0>;
+		VDDIO-supply = <&vreg_l14a_1p88>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&ts_int_active &ts_reset_active>;
+		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
+
+		/* Coordinates already match display orientation. */
+		touchscreen-size-x = <2560>;
+		touchscreen-size-y = <1600>;
+	};
 };
 
