 struct j716f_bc_cpu {
 	u32 seq;
+	u32 alert_stage;
+	u64 heartbeat;
 	struct j716f_bc_rec ring[J716F_BC_RING];
 };
 
 static DEFINE_PER_CPU(struct j716f_bc_cpu, j716f_bc_data);
+static DEFINE_PER_CPU(struct hrtimer, j716f_snap_timer);
