+		if (ret >= 0) {
+			prtd->phys = phys;
+			prtd->mapped = true;
+			dev_info(dev,
+				 "J716F: map dir=%d mode=%d phys=%#llx dma=%#llx period=%zu periods=%u accepted\n",
+				 substream->stream, attempt,
+				 (unsigned long long)phys,
+				 (unsigned long long)dma_addr, period_sz,
