 	if (!prtd->periods) {
 		dev_err(dev, "J716F: no periods for the DMA map\n");
 		return -EINVAL;
 	}
 	period_sz = prtd->pcm_size / prtd->periods;
-	phys = dma_addr | sid_bits;
 
